        {
          "name": "11. Error - Límite de usos alcanzado",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 for limit reached', function () {",
                  "  pm.response.to.have.status(400);",
