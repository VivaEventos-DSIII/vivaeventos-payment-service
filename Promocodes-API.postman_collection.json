            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FIXED100K\",\n  \"orderId\": \"{{orderId}}\",\n  \"originalAmount\": 500000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/promocodes/apply",
              "host": [
                "{{localhost}}"
              ],
              "path": [
                "api",
                "promocodes",
                "apply"
              ]
            },
            "description": "Aplica código FIXED100K (descuento fijo de 100,000 COP)"
          },
          "response": []
        },
        {
          "name": "7. Aplicar Descuento Fijo - Mayor que el monto",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Discount limited to amount, total is zero', function () {",
                  "  var jsonData = pm.response.json();",
                  "  // Descuento fijo 100K pero monto es 50K",
                  "  pm.expect(jsonData.discountApplied).to.equal(50000);",
                  "  pm.expect(jsonData.newTotal).to.equal(0);",
                  "  pm.expect(jsonData.newTotalInCents).to.equal(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"FIXED100K\",\n  \"orderId\": \"{{orderId}}\",\n  \"originalAmount\": 50000.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/promocodes/apply",
              "host": [
                "{{localhost}}"
              ],
              "path": [
                "api",
                "promocodes",
                "apply"
              ]
            },
            "description": "Descuento fijo de 100K aplicado a monto de 50K (no puede ser negativo)"
          },
          "response": []
        },
        {
          "name": "8. Aplicar Código - Case Insensitive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Code is case-insensitive', function () {",
                  "  var jsonData = pm.response.json();",
                  "  pm.expect(jsonData.code).to.equal('SUMMER20');",
                  "});"
                ]
              }
            }
          ],
          "request": {
