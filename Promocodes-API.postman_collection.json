            "url": {
              "raw": "{{baseUrl}}/api/promocodes/apply",
              "host": [
                "{{localhost}}"
              ],
              "path": [
                "api",
                "promocodes",
                "apply"
              ]
            },
            "description": "Prueba case-insensitive: 'summer20' (minúsculas)"
          },
          "response": []
